# Salin file ini jadi .env lalu isi nilainya.

# Postgres. Bisa lokal, atau Vercel Postgres kalau sudah di-deploy.
DATABASE_URL="postgresql://postgres:password@localhost:5432/sipras?schema=public"

# Kunci cookie sesi. Generate dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Resend. Boleh kosong, sistem otomatis pakai mode konsol saat demo.
RESEND_API_KEY=""
EMAIL_FROM="SIPRAS <onboarding@resend.dev>"
EMAIL_REPLY_TO="email@kamu.com"

# Kontak petugas sarpras (ditampilkan sebagai tautan wa.me, tanpa API)
NEXT_PUBLIC_WA_PETUGAS="08xxxxxxxxxx"
NEXT_PUBLIC_EMAIL_PETUGAS="email@kamu.com"

# Nama lembaga yang memakai sistem ini, tampil di baris hak cipta footer.
# Boleh dikosongkan: footer cuma menghilangkan namanya, tidak rusak.
NEXT_PUBLIC_NAMA_INSTANSI="UPTD SD Negeri 372 Sikara Kara"

# Alamat aplikasi, dipakai untuk tombol di dalam email supaya tautannya
# lengkap. Ganti ke domain asli saat sudah di-deploy.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mode uji email. Resend tanpa domain terverifikasi hanya mengirim ke alamat
# pemilik akun, sedangkan peminjam contoh memakai alamat lain yang pasti
# ditolak. Kalau diisi, SEMUA email dialihkan ke alamat ini dan subjeknya
# diberi awalan penerima aslinya.
#
# Kosongkan begitu punya domain terverifikasi sendiri.
EMAIL_UJI_KE=

# === PENGINGAT JATUH TEMPO ============================================
# Token untuk rute /api/pengingat yang dipanggil penjadwal sekali sehari.
# Tanpa token ini rutenya dimatikan, supaya tidak bisa dipicu sembarang
# orang untuk membanjiri peminjam dengan email.
PENGINGAT_SECRET=""

# === PENYIMPANAN FOTO (VERCEL BLOB) =====================================
# Diisi OTOMATIS begitu Blob diaktifkan lewat menu Storage di dashboard
# proyek Vercel. Tidak perlu disalin manual di produksi. Untuk coba di
# komputer sendiri, ambil nilainya dari menu yang sama lalu tempel di sini.
BLOB_READ_WRITE_TOKEN=""
