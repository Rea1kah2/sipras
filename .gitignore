# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Kecuali contohnya. Isinya cuma nama variabel dan nilai contoh, tanpa satu
# pun rahasia, dan justru berkas inilah yang memberitahu variabel apa saja
# yang harus diisi saat deploy. Tanpa baris ini pola .env* di atas ikut
# menelannya sehingga repo tidak punya dokumentasi konfigurasi sama sekali.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# foto aset yang diunggah admin, bukan bagian dari kode
/public/uploads

# Foto sumber aset sekolah. Bukan kode, dan sudah tersimpan permanen di
# Vercel Blob setelah diunggah, jadi tidak perlu membebani repositori.
/foto-aset

# Hasil `vercel env pull`, berisi kunci produksi sungguhan.
.env.vercel

# konfigurasi asisten AI, bukan bagian dari aplikasi
/.claude
/.agents
/.windsurf
skills-lock.json
